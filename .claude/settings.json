{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/elisp-check.sh\" 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Checking Emacs Lisp..."
          }
        ]
      }
    ]
  }
}
